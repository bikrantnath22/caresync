# Server-side Gemini API key used by Vercel serverless proxy (/api/gemini).
# Do NOT prefix with VITE_ to prevent leaking the secret key into client bundles.
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g. gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Demo Mode Toggle ("true" | "false")
# When "true": enables quick-switch role buttons, judge PIN guide, voice simulation buttons, and lockout demo buttons.
# When "false": switching roles requires entering the PIN on the keypad.
VITE_DEMO_MODE=true
